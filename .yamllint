---
extends: default

rules:
  indentation:
    spaces: 2
    indent-sequences: true
  # Long image references and label URLs are not worth wrapping.
  line-length: disable
  # Compose files do not use explicit document starts.
  document-start: disable
  # Upstream snippets use `##` and `#comment`; comments are preserved verbatim.
  comments:
    min-spaces-from-content: 1
    require-starting-space: false
  comments-indentation: disable
  # `on:`/`no:` style keys are legitimate in compose and workflow files.
  truthy:
    check-keys: false
